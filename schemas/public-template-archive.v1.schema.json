{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jarxunlai/ScientificFigureLibrary-community-archives/blob/main/schemas/public-template-archive.v1.schema.json",
  "title": "Scientific Figure Library public template archive v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "providerId", "templateId", "releaseVersion", "contentDigest", "metadata", "licenses", "render", "codeExecutedBySflClient"],
  "properties": {
    "schema": { "const": "figure-library.public-template-archive.v1" },
    "providerId": { "const": "io.github.jarxunlai.scientific-figure-community" },
    "templateId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,126}[a-z0-9]$" },
    "releaseVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metadata": { "type": "object" },
    "licenses": { "type": "object" },
    "render": { "type": "object" },
    "codeExecutedBySflClient": { "const": false }
  }
}
